spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/financeex?currentSchema=supervisor_dev
    username: fin_supervisor
    password: local-dev-password
    hikari:
      schema: supervisor_dev

financeex:
  redis:
    mode: standalone
    host: localhost
    port: 6379
    database: 0
    # 本地 Redis 无密码时保留为空；生产也必须显式配置该项或环境变量。
    password:
  websocket:
    allowed-origin-patterns: http://localhost:*,http://127.0.0.1:*,http://[::1]:*
  storage:
    provider: local
  agent-runtime:
    default-provider: relay
    relay:
      enabled: true
      websocket:
        url: ws://localhost:8080/ws
  intent:
    enabled: false
    base-url: http://localhost:9200
    access-name: local-intent
    invocation-mode: BLOCKING
    recognize-path: /intent-recognition-configuration/getIntentDecision
    recognize-stream-path: /intent-recognition-configuration/getIntentDecisionStream
    timeout: 5s
    stream-first-event-timeout: 5s
    stream-idle-timeout: 30s
    stream-total-timeout: 120s
    failure-strategy: RELAY_FALLBACK
  domain-agent:
    enabled: false
    base-url: http://localhost:9300
    # 可省略；为空时自动使用 base-url。
    referer: http://localhost:9300
    # 默认保留手动 DomainAgent 拒答后的用户切换确认。
    refusal-auto-switch-enabled: false
  use-case-library:
    enabled: false
    base-url: http://localhost:9100
